// generator client {
//  provider = "prisma-client"
 // output   = "../generated/prisma"
// }


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE ENTITIES
// ============================================

// Multi-tenant root - Every organization is isolated
model Organization {
  id     String  @id @default(cuid())
  name   String
  slug   String  @unique // URL-friendly name (acme-corp)
  domain String? // Custom domain for white-labeling

  // White-labeling & Branding
  brandName      String  @default("BookYourPTO") // Application name for white-labeling
  logoLightUrl   String? // Logo for light mode
  logoDarkUrl    String? // Logo for dark mode
  faviconUrl     String? // Main favicon
  faviconDarkUrl String? // Dark mode favicon
  customCSS      Json?   // Custom styling overrides

  // Privacy Settings
  calendarViewRestricted   Boolean @default(false)
  departmentViewRestricted Boolean @default(false)

  // Regional Settings
  timezone       String @default("UTC") // IANA timezone identifier (e.g., "America/New_York")
  dateFormat     String @default("YYYY-MM-DD")
  timeFormat     String @default("HH:mm") // 24h or 12h
  weekStartDay   Int    @default(1) // 1 = Monday, 0 = Sunday
  currency       String @default("USD")
  fiscalYearStart Int   @default(1) // Month (1-12)
  country        String @default("US") // For public holidays

  businessDays   String[] @default(["mon", "tue", "wed", "thu", "fri"])


  // Onboarding
  leaveYearStartMonth    Int     @default(1) // 1-12 (January - December)
  defaultLeaveAllowance  Float   @default(14) // Default days per year
  defaultSickLeaveAllowance Float @default(10)  // ADD THIS LINE
  onboardingCompleted    Boolean @default(false)

  // Email Configuration
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPassword     String? // Encrypted
  emailFromName    String  @default("BookYourPTO")
  emailFromAddress String?
  
  // Carry Forward Settings
  carryForwardDays      Float   @default(0)    // Max days that can be carried forward
  carryForwardHours     Float   @default(0)    // Max hours that can be carried forward
  carryForwardExpires   Boolean @default(false) // Whether carry forward expires
  carryForwardExpiryMonths Int? @default(12)   // Months until expiry (when enabled)
  
  // Billing & Subscription
  plan               String   @default("free") // free, pro, enterprise
  maxUsers           Int      @default(10)
  subscriptionStatus String   @default("trial") // trial, active, cancelled, suspended
  billingEmail       String?
  subscriptionEndsAt DateTime?

  // Features flags
  features Json? // { enableDocuments: true, enableReports: true, etc. }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users            User[]
  departments      Department[]
  leaveTypes       LeaveType[]
  publicHolidays   PublicHoliday[]
  holidayOverrides UserHolidayOverride[]
  leaves           Leave[]
  leaveBalances    LeaveBalance[]
  documents        Document[]
  approvalWorkflows ApprovalWorkflow[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  signInLogs       SignInLog[]
  emailTemplates   EmailTemplate[]
  securityViolations SecurityViolation[]

  @@index([slug])
}

// Departments within an organization
model Department {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  code           String // IT, HR, SALES, etc.
  description    String?
  color          String  @default("#3b82f6") // For calendar
  costCenter     String? // For accounting integration

  // Department Head
  headOfDepartmentId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]       @relation("DepartmentMembers")
  headOfDept   User?        @relation("DepartmentHead", fields: [headOfDepartmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([headOfDepartmentId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([token])
}


// Employees/Users
model User {
  id             String @id @default(cuid())
  organizationId String

  // Authentication
  email    String
  password String // Hashed with bcrypt
  emailVerificationToken String?
  emailVerificationExpiry DateTime?
  passwordResetToken      String?
  passwordResetExpiry     DateTime?
  refreshTokens RefreshToken[]


  // Basic Info
  firstName     String
  lastName      String
  middleName    String?
  preferredName String?
  avatar        String? // File path or URL
  dateOfBirth   DateTime?
  gender        String? // MALE, FEMALE, OTHER, PREFER_NOT_TO_SAY

  // Employment Details
  employeeId          String? // Company's employee ID
  jobTitle            String?
  departmentId        String?
  reportsToId         String? // Manager's User ID
  employmentType      EmploymentType @default(FULLTIME)
  employmentStartDate DateTime?
  employmentEndDate   DateTime? // For contract end or termination
  probationEndDate    DateTime?
  level               UserLevel      @default(STANDARD)

  // Contact Information
  phoneMobile   String?
  phoneLandline String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?

  // Emergency Contact (stored as JSON)
  emergencyContact Json? // { name, relationship, phonePrimary, phoneSecondary, address }

  // Payroll & Banking
  payrollId          String?
  bankAccountDetails Json? // Encrypted: { accountNumber, routingNumber, bankName }
  taxId              String?

  // Role & Permissions
  role                 UserRole  @default(EMPLOYEE)
  isApprover           Boolean   @default(false)
  canApproveDepartments String[] // Array of Department IDs
  permissions          Json? // Granular permissions: { canExportData: true, etc. }

  // Work Schedule (stored as JSON)
  workSchedule Json? // { monday: { start: "09:00", end: "17:00", isWorkday: true }, ... }
  scheduleRepeatsWeekly Boolean @default(true)
  scheduleEffectiveFrom DateTime?
  scheduleEffectiveTo   DateTime?
  timezone     String @default("UTC") // User-specific timezone override (IANA identifier)
  hoursPerWeek Float  @default(40)
  

  // Leave Balances (Quick access - detailed tracking in LeaveBalance table)
  annualLeaveBalance   Float @default(0)
  sickLeaveBalance     Float @default(0)
  carryOverBalance     Float @default(0)

   // NEW: Carry Forward Settings
  allowCarryForward    Boolean @default(true)  
  maxCarryForwardDays  Float?              


  customLeaveAllowance Float? // Override organization default
  customLeaveBalances  Json? // Other leave types: { MATERNITY: 90, etc. }

  // Holiday Location Override
  holidayCountry String? // Override org holiday country (e.g., "US", "GB")
  holidayRegion  String? // Specific region/state (e.g., "CA", "NY")

  // Status & Activity
  isActive           Boolean   @default(true)
  emailVerified      Boolean   @default(false)
  lastLoginAt        DateTime?
  profileCompleteness Int      @default(0) // 0-100%

  // Files
  documentsFolderId String? // Docker volume path

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department        Department?        @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  manager           User?              @relation("ManagerEmployees", fields: [reportsToId], references: [id], onDelete: SetNull)
  employees         User[]             @relation("ManagerEmployees")
  departmentsHeaded Department[]       @relation("DepartmentHead")
  leaves            Leave[]            @relation("LeaveRequester")
  leaveBalances     LeaveBalance[]
  documents         Document[]         @relation("DocumentOwner")
  uploadedDocuments Document[]         @relation("DocumentUploader")
  notifications     Notification[]
  auditLogs         AuditLog[]
  signedDocuments   Document[]         @relation("DocumentSigner")
  firstLevelApprovals Leave[]          @relation("FirstLevelApprover")
  secondLevelApprovals Leave[]         @relation("SecondLevelApprover")
  holidayOverrides  UserHolidayOverride[]
  securityViolations SecurityViolation[]

  @@unique([organizationId, email])
  @@unique([organizationId, employeeId])
  @@index([organizationId])
  @@index([departmentId])
  @@index([reportsToId])
  @@index([email])
  @@index([isActive])
}

// Leave Types (Annual, Sick, Maternity, etc.)
model LeaveType {
  id             String @id @default(cuid())
  organizationId String

  name        String // "Annual Leave", "Sick Leave - Paid", "Maternity Leave"
  code        LeaveTypeCode // Enum for consistency
  description String?
  color       String        @default("#3b82f6")
  icon        String?       // Icon name for UI

  // Configuration
  requiresApproval       Boolean @default(true)
  requiresDocumentation  Boolean @default(false) // Medical certificate, etc.
  maxDaysPerRequest      Int?    // Max days in single request
  minDaysNotice          Int     @default(0) // Days in advance required
  allowHalfDays          Boolean @default(true)
  allowQuarterDays       Boolean @default(false)
  allowHourly            Boolean @default(false)
  paidLeave              Boolean @default(true)

  // Allowance Settings
  annualAllowance  Float?   // Days per year
  hasAccrual       Boolean  @default(false) // Does it accrue monthly?
  accrualRate      Float?   // Days per month if accrual
  accrualStartDate DateTime? // When accrual starts
  carryOverAllowed Boolean  @default(false)
  maxCarryOverDays Float?
  expiryMonths     Int?     // Months until carried over days expire

  deductionBucket DeductionBucket @default(NONE)  // Which bucket this leave type deducts from

  // Approval Workflow
  requiresFirstLevelApproval  Boolean @default(true) // Manager
  requiresSecondLevelApproval Boolean @default(false) // Department Head
  autoApproveAfterDays        Int? // Auto-approve if not responded

  // Visibility & Access
  isActive               Boolean  @default(true)
  availableForRoles      String[] // Which roles can use this
  availableForDepartments String[] // Which departments (empty = all)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaves        Leave[]
  leaveBalances LeaveBalance[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
}

// Public Holidays
model PublicHoliday {
  id             String  @id @default(cuid())
  organizationId String
  country        String
  region         String? // For regional holidays (e.g., "California")
  name           String
  date           DateTime // Stored in UTC, displayed in organization timezone
  isRecurring    Boolean @default(true) // Recurs annually
  recurringPattern Json? // For complex patterns
  affectedDepartments String[] // Empty = all departments
  isHalfDay      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userOverrides UserHolidayOverride[] @relation("HolidayToOverride")

  @@index([organizationId])
  @@index([date])
  @@index([country])
}

// User-specific Holiday Overrides
model UserHolidayOverride {
  id             String  @id @default(cuid())
  userId         String
  organizationId String

  // Override Type
  type           UserHolidayOverrideType // EXCLUDE or ADD

  // For EXCLUDE: reference to org holiday being excluded
  publicHolidayId String?

  // For ADD: custom holiday details
  name       String?
  date       DateTime?
  isRecurring Boolean @default(true)
  isHalfDay  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  publicHoliday PublicHoliday? @relation("HolidayToOverride", fields: [publicHolidayId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([publicHolidayId])
}

// Leave Requests (Time-off requests)
model Leave {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  leaveTypeId    String

  // Leave Details
  startDate  DateTime // Stored in UTC, interpreted in organization timezone
  endDate    DateTime // Stored in UTC, interpreted in organization timezone
  startHalf  DayPortion @default(FULL_DAY) // FULL_DAY, FIRST_HALF, SECOND_HALF
  endHalf    DayPortion @default(FULL_DAY)
  totalDays  Float // Calculated: accounting for half days, weekends, holidays
  totalHours Float? // For hourly leave types
  reason     String?
  notes      String?

  // Status & Approval Flow
  status     LeaveStatus @default(PENDING)
  submittedAt DateTime   @default(now())

  // First Level Approval (usually direct manager)
  firstLevelApproverId String?
  firstLevelApprovedAt DateTime?
  firstLevelComment    String?

  // Second Level Approval (department head, HR, etc.)
  secondLevelApproverId String?
  secondLevelApprovedAt DateTime?
  secondLevelComment    String?

  // Rejection/Cancellation
  rejectionReason String?
  cancelledAt     DateTime?
  cancelledReason String?
  cancelledBy     String? // User ID who cancelled

  // Calendar Integration
  googleEventId   String?
  outlookEventId  String?
  syncedToCalendar Boolean @default(false)

  // Attachments (medical certificates, etc.)
  attachmentUrls String[] // Array of file paths

  // Balance Impact Tracking
  deductedFrom    String? // Which leave balance (leaveTypeId)
  balanceSnapshot Json? // { before: 20, after: 18, deducted: 2 }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  leaveType          LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  firstLevelApprover User?        @relation("FirstLevelApprover", fields: [firstLevelApproverId], references: [id], onDelete: SetNull)
  secondLevelApprover User?       @relation("SecondLevelApprover", fields: [secondLevelApproverId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([leaveTypeId])
  @@index([status])
  @@index([startDate, endDate])
  @@index([userId, status])
}

// Leave Balance Tracking (Historical & Current)
model LeaveBalance {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  leaveTypeId    String
  year           Int // Fiscal year
  fiscalPeriodStart DateTime // Stored in UTC
  fiscalPeriodEnd   DateTime // Stored in UTC

  // Balance Tracking
  openingBalance Float @default(0) // Balance at start of year
  earned         Float @default(0) // From accrual during year
  used           Float @default(0) // Days taken
  adjusted       Float @default(0) // Manual adjustments by admin
  carriedOver    Float @default(0) // From previous year
  expired        Float @default(0) // Carried over days that expired
  currentBalance Float @default(0) // Calculated field

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)

  @@unique([userId, leaveTypeId, year])
  @@index([organizationId])
  @@index([userId])
  @@index([year])
}

// Document Management (Employee files, contracts, certificates)
model Document {
  id             String @id @default(cuid())
  organizationId String
  userId         String // Owner of the document
  uploadedById   String // Who uploaded it

  // Document Info
  title       String
  description String?
  category    DocumentCategory
  type        String // MIME type or extension

  // File Storage (Docker volumes)
  filePath String // /documents/{orgId}/{userId}/{year}/{filename}
  fileName String
  fileSize Int // In bytes
  mimeType String
  checksum String // SHA256 for integrity verification
  version  Int    @default(1) // For document versioning

  // E-Signature Support
  requiresSignature  Boolean         @default(false)
  signatureStatus    SignatureStatus @default(NOT_REQUIRED)
  signatureDeadline  DateTime?
  signedAt           DateTime?
  signedByUserId     String?
  signatureData      String? // Base64 signature image
  signatureIpAddress String?
  signatureUserAgent String?

  // Access Control
  isPrivate        Boolean   @default(false) // Only user + HR can see
  sharedWithUsers  String[] // User IDs with access
  sharedWithRoles  String[] // Roles with access (ADMINISTRATOR, HR, etc.)
  expiryDate       DateTime? // For temporary access

  // Metadata
  tags         String[]
  customFields Json? // Flexible additional data

  // Soft Delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("DocumentOwner", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedById], references: [id])
  signedBy     User?        @relation("DocumentSigner", fields: [signedByUserId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([category])
  @@index([deletedAt])
}

// Approval Workflows (Configurable approval chains)
model ApprovalWorkflow {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  description    String?

  // Workflow Configuration
  triggerType WorkflowTrigger // LEAVE_REQUEST, DOCUMENT_APPROVAL, etc.
  conditions  Json // { leaveTypeIds: [], departmentIds: [], minDays: 5, userLevels: [] }

  // Approval Steps (Sequential)
  approvalSteps Json // [{ step: 1, approverType: "DIRECT_MANAGER", timeoutDays: 3 }]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([triggerType])
}

// Notifications (In-app & Email)
model Notification {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  message        String
  actionUrl      String?
  priority       NotificationPriority @default(MEDIUM)

  isRead       Boolean   @default(false)
  readAt       DateTime?
  sentViaEmail Boolean   @default(false)
  sentViaInApp Boolean   @default(true)

  metadata Json? // Additional context data

  createdAt DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// Audit Logs (Compliance & Security)
model AuditLog {
  id             String @id @default(cuid())
  organizationId String
  userId         String? // Null for system actions
  action         AuditAction
  entityType     String // USER, LEAVE, DOCUMENT, etc.
  entityId       String
  changes        Json? // { before: {...}, after: {...} }
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

// Sign-in Logs (Security & Compliance)
model SignInLog {
  id             String @id @default(cuid())
  organizationId String
  userId         String?
  email          String

  // Sign-in Details
  success        Boolean
  failureReason  String? // Invalid password, account locked, etc.

  // Device & Location Information
  ipAddress      String
  userAgent      String
  deviceType     String? // mobile, desktop, tablet
  browser        String? // Chrome, Firefox, Safari, etc.
  os             String? // Windows, macOS, Linux, iOS, Android
  country        String?
  city           String?

  // Session Information
  sessionId      String?

  timestamp      DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([email])
  @@index([success])
  @@index([timestamp])
  @@index([ipAddress])
}

// Email Templates (Customizable)
model EmailTemplate {
  id             String @id @default(cuid())
  organizationId String
  type           EmailTemplateType
  subject        String
  bodyHtml       String @db.Text
  bodyText       String @db.Text
  variables      Json // Available placeholders: { userName, leaveType, etc. }
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@index([organizationId])
}

// ============================================
// ENUMS
// ============================================

enum EmploymentType {
  FULLTIME
  PARTTIME
  CONTRACT
  INTERN
  TEMPORARY
  SEASONAL
}

enum DeductionBucket {
    NONE       // Doesn't deduct from any bucket
    ANNUAL     // Deducts from annual leave bucket
    SICK       // Deducts from sick leave bucket
  }
  
enum UserRole {
  EMPLOYEE
  DEPARTMENT_HEAD
  ADMINISTRATOR
  EXECUTIVE
}

enum UserLevel {
  STANDARD
  DIRECTOR
  EXECUTIVE
  ADMINISTRATOR
}

enum LeaveTypeCode {
  ANNUAL              // Annual/Vacation Leave
  SICK_PAID           // Paid Sick Leave
  SICK_UNPAID         // Unpaid Sick Leave
  MATERNITY           // Maternity Leave
  PATERNITY           // Paternity Leave
  PARENTAL            // Parental Leave
  BEREAVEMENT         // Bereavement/Compassionate Leave
  JURY_DUTY           // Jury Duty
  MEDICAL             // Medical Leave
  SABBATICAL          // Sabbatical Leave
  STUDY               // Study Leave
  MILITARY            // Military Leave
  MARRIAGE            // Marriage Leave
  MOVING              // Moving/Relocation Leave
  VOLUNTEER           // Volunteer Leave
  UNPAID              // Unpaid Leave
  WFH                 // Work From Home (tracking)
  MEETING             // Out for Meeting
  TRAINING            // Training/Conference
  SPECIAL             // Special Circumstances
  EMERGENCY           // Emergency Leave
  QUARANTINE          // Quarantine/Isolation
  COMPENSATORY        // Compensatory Time Off
  RELIGIOUS           // Religious Observance
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum DayPortion {
  FULL_DAY
  FIRST_HALF      // Morning
  SECOND_HALF     // Afternoon
  QUARTER_MORNING // First quarter
  QUARTER_AFTERNOON // Last quarter
}

enum DocumentCategory {
  CONTRACT
  OFFER_LETTER
  SALARY_INCREMENT
  PERFORMANCE_REVIEW
  POLICY_DOCUMENT
  ID_DOCUMENT
  CERTIFICATE
  TRAINING_MATERIAL
  MEDICAL_CERTIFICATE
  VISA_DOCUMENT
  TAX_DOCUMENT
  INSURANCE
  OTHER
}

enum SignatureStatus {
  NOT_REQUIRED
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum WorkflowTrigger {
  LEAVE_REQUEST
  DOCUMENT_APPROVAL
  EXPENSE_APPROVAL
  TIMESHEET_APPROVAL
  USER_ONBOARDING
  USER_OFFBOARDING
}

enum NotificationType {
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  LEAVE_REMINDER
  DOCUMENT_UPLOADED
  DOCUMENT_SIGNED
  DOCUMENT_EXPIRES_SOON
  APPROVAL_REQUIRED
  BALANCE_LOW
  SYSTEM_ANNOUNCEMENT
  POLICY_UPDATE
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  CANCEL
  SIGN
  DOWNLOAD
  EXPORT
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  SETTINGS_CHANGE
}

enum EmailTemplateType {
  WELCOME
  PASSWORD_RESET
  EMAIL_VERIFICATION
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  LEAVE_CANCELLED
  LEAVE_REMINDER
  APPROVAL_REQUIRED
  DOCUMENT_SIGNED
  BALANCE_UPDATED
  POLICY_UPDATE
}

enum UserHolidayOverrideType {
  EXCLUDE // Exclude an organization holiday for this user
  ADD     // Add a custom holiday for this user
}

// ============================================
// SECURITY VIOLATIONS LOG
// ============================================
model SecurityViolation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String? // May be null if user deleted

  // Violation Details
  violationType  SecurityViolationType
  description    String
  severity       SecuritySeverity @default(MEDIUM)

  // Tampering Evidence
  attemptedRole  String? // Role they tried to set
  actualRole     String? // Role from JWT
  tamperedData   Json?   // What they modified

  // Device & Location
  ipAddress      String
  userAgent      String
  deviceType     String?
  browser        String?
  os             String?
  country        String?
  city           String?

  // Action Taken
  actionTaken    String  @default("FORCE_LOGOUT") // FORCE_LOGOUT, ACCOUNT_LOCKED, etc.

  // Investigation
  reviewed       Boolean @default(false)
  reviewedBy     String? // Admin who reviewed
  reviewedAt     DateTime?
  notes          String? // Admin notes

  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([violationType])
  @@index([createdAt])
  @@index([reviewed])
}

enum SecurityViolationType {
  LOCALSTORAGE_TAMPERING  // Modified user data in localStorage
  JWT_MISMATCH            // JWT doesn't match localStorage
  INVALID_JWT             // Corrupted or fake JWT
  UNAUTHORIZED_ACCESS     // Tried to access forbidden route
  API_PERMISSION_DENIED   // API rejected due to insufficient permissions
  SESSION_HIJACK_ATTEMPT  // Suspicious session activity
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

